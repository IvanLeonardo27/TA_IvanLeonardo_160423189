      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ExploreRelated_di" bpmnElement="Gateway_ExploreRelated" isMarkerVisible="true" bioc:stroke="#b45309" bioc:fill="#fef3c7">
        <dc:Bounds x="1355" y="375" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1342" y="432" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0qaabem_di" bpmnElement="Task_OpenPanel">
        <dc:Bounds x="340" y="130" width="100" height="80" />
