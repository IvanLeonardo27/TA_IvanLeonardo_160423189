        <dc:Bounds x="1095" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0w159kd_di" bpmnElement="Task_FetchCatalog">
        <dc:Bounds x="400" y="610" width="100" height="80" />
