<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_Wayang_Learning" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.25.1">
  <bpmn:collaboration id="Collaboration_Wayang">
    <bpmn:participant id="Participant_Wayang" name="4.2.8 Proses Pembelajaran Mandiri Pewayangan Jawa - BasaKula" processRef="Process_Wayang" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Wayang" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Wayang">
      <bpmn:lane id="Lane_Teacher" name="Pengajar / Admin">
        <bpmn:flowNodeRef>StartEvent_Teacher</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Teacher</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpenPanel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitWayang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InputWayang</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Student" name="Pelajar">
        <bpmn:flowNodeRef>StartEvent_Student</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Student</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ExploreRelated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BrowseCatalog</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FilterWayang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StudyContent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Sistem BasaKula (Web &#38; Database)">
        <bpmn:flowNodeRef>Task_FetchCatalog</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExecFilter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FetchDetail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MutateDB</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Teacher" name="Mulai">
      <bpmn:outgoing>Flow_T1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="StartEvent_Student" name="Mulai">
      <bpmn:outgoing>Flow_S1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_T1" sourceRef="StartEvent_Teacher" targetRef="Task_OpenPanel" />
    <bpmn:sequenceFlow id="Flow_T2" sourceRef="Task_OpenPanel" targetRef="Task_InputWayang" />
    <bpmn:sequenceFlow id="Flow_T3" sourceRef="Task_InputWayang" targetRef="Task_SubmitWayang" />
    <bpmn:sequenceFlow id="Flow_T4" sourceRef="Task_SubmitWayang" targetRef="Task_MutateDB" />
    <bpmn:sequenceFlow id="Flow_T5" sourceRef="Task_MutateDB" targetRef="EndEvent_Teacher" />
    <bpmn:sequenceFlow id="Flow_S1" sourceRef="StartEvent_Student" targetRef="Task_BrowseCatalog" />
    <bpmn:sequenceFlow id="Flow_S2" sourceRef="Task_BrowseCatalog" targetRef="Task_FetchCatalog" />
    <bpmn:sequenceFlow id="Flow_S3" sourceRef="Task_FetchCatalog" targetRef="Task_FilterWayang" />
    <bpmn:sequenceFlow id="Flow_S4" sourceRef="Task_FilterWayang" targetRef="Task_ExecFilter" />
    <bpmn:sequenceFlow id="Flow_S5" sourceRef="Task_ExecFilter" targetRef="Task_SelectCard" />
    <bpmn:sequenceFlow id="Flow_S6" sourceRef="Task_SelectCard" targetRef="Task_FetchDetail" />
    <bpmn:sequenceFlow id="Flow_S7" sourceRef="Task_FetchDetail" targetRef="Task_StudyContent" />
    <bpmn:sequenceFlow id="Flow_S8" sourceRef="Task_StudyContent" targetRef="Gateway_ExploreRelated" />
    <bpmn:sequenceFlow id="Flow_S9" name="Ya" sourceRef="Gateway_ExploreRelated" targetRef="Task_SelectCard" />
    <bpmn:sequenceFlow id="Flow_S10" name="Tidak" sourceRef="Gateway_ExploreRelated" targetRef="EndEvent_Student" />
    <bpmn:endEvent id="EndEvent_Student" name="Selesai Mempelajari">
      <bpmn:incoming>Flow_S10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Teacher" name="Selesai: Data Pewayangan Diperbarui">
      <bpmn:incoming>Flow_T5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_ExploreRelated" name="Ingin Eksplorasi Tokoh Terkait?">
      <bpmn:incoming>Flow_S8</bpmn:incoming>
      <bpmn:outgoing>Flow_S9</bpmn:outgoing>
      <bpmn:outgoing>Flow_S10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_OpenPanel" name="Membuka Panel Kelola Data Pewayangan">
      <bpmn:incoming>Flow_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_T2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SubmitWayang" name="Simpan Data Tokoh Pewayangan">
      <bpmn:incoming>Flow_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_T4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_BrowseCatalog" name="Membuka Katalog &#38; Ensiklopedia Pewayangan">
      <bpmn:incoming>Flow_S1</bpmn:incoming>
      <bpmn:outgoing>Flow_S2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_FilterWayang" name="Filter Kategori / Filter Keberpihakan / Pencarian Realtime">
      <bpmn:incoming>Flow_S3</bpmn:incoming>
      <bpmn:outgoing>Flow_S4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SelectCard" name="Klik Kartu Tokoh atau Tombol Intip Preview">
      <bpmn:incoming>Flow_S5</bpmn:incoming>
      <bpmn:incoming>Flow_S9</bpmn:incoming>
      <bpmn:outgoing>Flow_S6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_StudyContent" name="Mempelajari Detail Tokoh: Alias, Peran, Watak, Senjata, Kisah &#38; Silsilah">
      <bpmn:incoming>Flow_S7</bpmn:incoming>
      <bpmn:outgoing>Flow_S8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_FetchCatalog" name="Select Data  &#39;wayang_categories&#39; &#38;  &#39;wayang_characters&#39;">
      <bpmn:incoming>Flow_S2</bpmn:incoming>
      <bpmn:outgoing>Flow_S3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ExecFilter" name="Eksekusi Query Filter &#38; Paginasi Data Tokoh">
      <bpmn:incoming>Flow_S4</bpmn:incoming>
      <bpmn:outgoing>Flow_S5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_FetchDetail" name="Select Detail Tokoh &#38; Load Tokoh Terkait Kategori Serupa">
      <bpmn:incoming>Flow_S6</bpmn:incoming>
      <bpmn:outgoing>Flow_S7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_MutateDB" name="Simpan Berkas Gambar ke Storage &#38; Insert/Update ke Database">
      <bpmn:incoming>Flow_T4</bpmn:incoming>
      <bpmn:outgoing>Flow_T5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_InputWayang" name="Input Data &#38; Foto Tokoh">
      <bpmn:incoming>Flow_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_T3</bpmn:outgoing>
    </bpmn:task>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Wayang">
    <bpmndi:BPMNPlane id="BPMNPlane_Wayang" bpmnElement="Collaboration_Wayang">
      <bpmndi:BPMNShape id="Participant_Wayang_di" bpmnElement="Participant_Wayang" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1660" height="690" />
